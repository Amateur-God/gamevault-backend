# GameVault backend — example environment configuration.
# Copy to `.env` (git-ignored) and adjust. Full schema: src/configuration.ts
# Never commit real secrets.

# ---- Database ----
# DB_SYSTEM=SQLITE to run without Docker (fully offline dev).
DB_SYSTEM=POSTGRESQL
DB_HOST=localhost
# Dev Postgres is published on host port 5433 (see docker-compose.dev.yml).
DB_PORT=5433
DB_USERNAME=gamevault
DB_PASSWORD=gamevault
DB_DATABASE=gamevault
# When false, TypeORM migrations run automatically on start.
DB_SYNCHRONIZE=false
DB_DEBUG=false

# ---- Server ----
# SERVER_PORT defaults to 8080. Leave unset here: setting it in .env would
# override a YAML-fallback unit test (configuration.spec.ts) during `pnpm test`.
# SERVER_PORT=8080
SERVER_LOG_LEVEL=debug
# Allow the first account to register, and skip email activation in dev.
SERVER_REGISTRATION_DISABLED=false
SERVER_ACCOUNT_ACTIVATION_DISABLED=true

# ---- Local dev volumes (relative paths for Windows/local runs) ----
VOLUMES_CONFIG=./.local/config
VOLUMES_FILES=./.local/files
VOLUMES_MEDIA=./.local/media
VOLUMES_LOGS=./.local/logs
VOLUMES_SQLITEDB=./.local/db
VOLUMES_PLUGINS=./.local/plugins
VOLUMES_SAVEFILES=./.local/savefiles

# ---- Optional: IGDB metadata provider ----
# METADATA_IGDB_CLIENT_ID=
# METADATA_IGDB_CLIENT_SECRET=

# ---- Optional: Steam metadata provider ----
# Store metadata + search work without a key. An API key is only required to
# import achievement schemas, user unlock state, and historical playtime.
# METADATA_STEAM_ENABLED=true
# METADATA_STEAM_PRIORITY=8
# METADATA_STEAM_API_KEY=
